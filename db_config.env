# 행사 등록 앱 환경 설정 (공개되어도 되는 값만 이 파일에 둡니다)
# Firebase 프로젝트 식별 정보 — 서버(Admin SDK)가 어느 프로젝트/저장소를 쓸지 알려 줍니다.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=summer-event-reg
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=summer-event-reg.firebasestorage.app

# ⚠️ 비밀 값은 절대 이 파일에 넣지 마세요 (이 파일은 GitHub에 올라갑니다).
#   SESSION_SECRET, SUPER_ADMIN_PASSWORD 는 Cloud Run의 Secret Manager 설정으로만 넣습니다.
