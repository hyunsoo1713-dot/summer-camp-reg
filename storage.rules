rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 행사 안내 이미지: 누구나 볼 수만 있습니다. (업로드는 관리자 로그인 후 서버를 통해서만 가능)
    match /events/{eventId}/images/{imageFile} {
      allow read: if true;
      allow write: if false;
    }
    // 그 밖의 모든 경로는 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
